{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": "Applies when Claude Code is launched from inside this repo. From the Memoryful workspace root, the root .claude/settings.json loads instead — settings come from the launch directory only, unlike CLAUDE.md which is hierarchical.",

  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run type-check)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run test:unit:*)",
      "Bash(npm run build:*)",
      "Bash(npx prettier:*)",
      "Bash(npx vue-tsc:*)",
      "Bash(curl http://localhost:3000/*)",
      "Bash(curl http://localhost:8000/*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],

    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npm run test:e2e:*)"
    ],

    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/*.pem)",
      "Edit(./dist/**)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
